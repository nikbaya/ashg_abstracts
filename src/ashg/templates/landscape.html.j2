{% extends "base.html.j2" %}
{% block content %}
<h1>{{ page.title }} <a class="sim-methods" href="methods.html#landscape">see methods ›</a></h1>
<p class="lede sim-help">Every ASHG abstract from {{ years[0].year }} to {{ years[-1].year }} as a dot, placed so that abstracts with similar wording sit close together, on one map for all the years.</p>
<p class="sim-help">Search an author to show their + label and path through the years. The web and abstract-node highlights start off; choose co-authors or similar text in the author's card options to draw a web. Search for another author under “Merge paths” in the card to combine their yearly paths; remove a name from the list to undo it. Turn on “Show co-author abstracts” there to highlight the searched author's abstracts and, in co-authors mode, linked co-author abstracts. The card also lets you show a target on abstracts they lead. Search more people to label several; the tooltip's button labels a clicked dot's first author. Toggle years to show only some of them. Paint a keyword or an institution to see where it sits on the map. Keywords group spellings that mean
the same thing (PPI and protein-protein interaction). Hover a dot for details; drag to pan and scroll or pinch to zoom. Titles and abstract text are not shown here.</p>
<div id="landscape" class="landscape" data-src="{{ landscape_src }}" data-syn="{{ landscape_syn_src or '' }}">
<div class="ls-bar">
  <span class="lbl">Author</span>
  <span class="ls-ac">
    <input id="ls-author" type="search" placeholder="e.g. Alexander Bick" autocomplete="off" aria-label="Search for an author"
      role="combobox" aria-expanded="false" aria-controls="ls-author-list" aria-autocomplete="list">
    <ul id="ls-author-list" class="ls-suggest" role="listbox" hidden></ul>
  </span>
  <button type="button" id="ls-author-clear" class="ls-link" hidden>Clear</button>
  <button type="button" id="ls-label-clear" class="ls-link" hidden>Clear labels</button>
  <label class="ls-check"><input id="ls-animate" type="checkbox" checked> Animate path</label>
  <span class="lbl"></span>
  <details id="ls-years" class="ls-years">
    <summary id="ls-years-summary">All years</summary>
    <div class="ls-years-menu">
      <label><input id="ls-years-all" type="checkbox" checked> Select all years</label>
      <div id="ls-year-options"></div>
    </div>
  </details>
  <span id="ls-legend" class="ls-legend" hidden><span>10%</span><i id="ls-legend-bar"></i><span>100% text match</span></span>
  <span id="ls-info" class="ls-info">Search an author to highlight their abstracts and trace their path through the years.</span>
</div>
<form class="ls-bar" id="ls-paint-form" autocomplete="off">
  <span class="lbl">Paint</span>
  <span class="ls-ac">
    <input id="ls-paint" type="text" placeholder="Keyword or institution, e.g. MPRA" autocomplete="off" aria-label="Keyword or institution to paint"
      role="combobox" aria-expanded="false" aria-controls="ls-paint-list" aria-autocomplete="list">
    <ul id="ls-paint-list" class="ls-suggest" role="listbox" hidden></ul>
  </span>
  <button type="submit">Add layer</button>
  <button type="button" id="ls-paint-clear" class="ls-link" hidden>Clear all paint</button>
  <span id="ls-paint-msg" class="ls-info"></span>
</form>
<ul id="ls-labels" class="ls-layers" aria-label="Labeled people"></ul>
<ul id="ls-layers" class="ls-layers" aria-label="Active paint layers"></ul>
<div id="ls-stage" class="sim-stage ls-stage">
  <canvas id="ls-canvas" role="img" aria-label="Map of ASHG abstracts from {{ years[0].year }} to {{ years[-1].year }}, one dot per abstract"></canvas>
  <details id="ls-map-legend" class="ls-map-legend">
    <summary>Map legend</summary>
    <ul>
      <li><span class="ls-legend-symbol ls-legend-label"></span><span><strong>Label marker (+)</strong> — first-author abstract location; if none, center of all their abstracts.</span></li>
      <li><span class="ls-legend-symbol ls-legend-coauthor"></span><span><strong>Co-author abstract</strong> — a nearby abstract by one of their co-authors.</span></li>
      <li><span class="ls-legend-symbol ls-legend-similar"></span><span><strong>Similar-text link</strong> — links from abstracts the author led are dark gray with larger dots; links from abstracts they co-authored are light gray.</span></li>
      <li><span class="ls-legend-symbol ls-legend-target"></span><span><strong>First-author abstracts</strong> — each abstract they lead.</span></li>
      <li><span class="ls-legend-symbol ls-legend-path"></span><span><strong>Yearly centers</strong> — solid nodes use first-author platform talks when available, otherwise other first-author abstracts; hollow nodes are inferred from coauthored abstracts. Joined by a solid path.</span></li>
    </ul>
  </details>
  <button type="button" id="ls-reset" class="ls-reset">Reset view</button>
  <div id="ls-tip" class="sim-tip ls-tip" hidden></div>
</div>
<section class="ls-cluster-control" aria-labelledby="ls-cluster-title">
  <div class="ls-cluster-heading">
    <label id="ls-cluster-title" class="ls-cluster-toggle"><input id="ls-clusters-toggle" type="checkbox"> Show preloaded topic clusters</label>
  </div>
  <div id="ls-cluster-settings" class="ls-cluster-settings" hidden>
    <section class="ls-cluster-section" data-cluster-section="Research areas">
      <button type="button" class="ls-cluster-section-title">Research areas</button>
      <ul id="ls-cluster-research" class="ls-cluster-list" aria-label="Research area clusters"></ul>
    </section>
    <section class="ls-cluster-section" data-cluster-section="Diseases">
      <button type="button" class="ls-cluster-section-title">Diseases</button>
      <ul id="ls-cluster-diseases" class="ls-cluster-list" aria-label="Disease clusters"></ul>
    </section>
    <p id="ls-cluster-info" class="ls-cluster-info">Click a section heading to hide or show all its topics. Click a topic to toggle it; right-click a section or topic to isolate it. Right-click it again to restore others, or click another topic to add it to the shown set. Each topic is a compact contour around its highest-density region; sparse topics and overlapping labels are omitted.</p>
  </div>
</section>
<p class="ls-count"><span id="ls-count"></span></p>
</div>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="assets/landscape.js?v={{ asset_v }}"></script>
{% endblock %}
