{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block content %}
<h1>{{ page.title }}</h1>
<p class="lede">Where the meeting's first authors are, and talk rate by world region, country and metro area.</p>
<nav class="toc" aria-label="On this page">{% if center_json %}<a href="#center">Center of mass</a>{% endif %}<a href="#regions">World regions</a><a href="#countries">Countries</a><a href="#metros">Metro areas</a></nav>
{% if center_json %}
<h2 id="center">Center of mass</h2>
<p>Where the first authors are, on average: the geographic midpoint of every first author's metro area, year by year
(an abstract with first authors in several metros counts a fraction in each). It spans every year, so the year
toggle below applies only to the sections after it. The center follows the meeting: local groups bring extra abstracts to a home meeting.</p>
{% if "trends_center_na" in trends %}
{{ m.figure("img/trends_center_na.png", "Map of North America and a zoom on Illinois and Indiana, with the yearly center of US and Canadian first authors' metro areas moving toward each year's host city.", "North America (US and Canada), all accepted abstracts.") }}
{% endif %}
{% if "trends_center_world" in trends %}
{{ m.figure("img/trends_center_world.png", "World map and a zoom on northern Ontario and Quebec, with the yearly worldwide center of first authors.", "Worldwide, all accepted abstracts.") }}
{% endif %}
<h3>Explore: talks, host city, North America</h3>
<div id="com" class="com" hidden>
  <div class="filters">
    <span class="lbl">Map</span>
    <span class="seg" role="group" aria-label="Map" data-com="map"><button type="button" data-value="na">North America</button><button type="button" data-value="world">Worldwide</button></span>
    <span class="lbl">Show</span>
    <span class="seg" role="group" aria-label="Show" data-com="group"><button type="button" data-value="abstracts">All abstracts</button><button type="button" data-value="talks">Talks</button></span>
  </div>
  <div class="filters">
    <span class="lbl">Host-city first authors</span>
    <span class="seg" role="group" aria-label="Host-city first authors" data-com="host"><button type="button" data-value="with">Included</button><button type="button" data-value="without">Removed</button></span>
    <span id="com-na-ctl"><span class="lbl">North American first authors</span>
    <span class="seg" role="group" aria-label="North American first authors" data-com="na"><button type="button" data-value="with">Included</button><button type="button" data-value="without">Removed</button></span></span>
  </div>
  <svg id="com-map" class="com-map" role="img"></svg>
  <div class="legend"><span><i class="com-key dot"></i><span id="com-dot-key">center of mass, each year</span></span>
    <span id="com-ghost-key"><i class="com-key ghost"></i>with host-city first authors</span></div>
  <p id="com-note"></p>
  <details class="table"><summary>Table</summary>
  <div class="scroll"><table id="com-table"><thead><tr><th class="text">Year</th><th class="text">Host city</th>
  <th class="text">Center</th><th id="com-n-head">Abstracts</th><th>From host city</th><th>Moved by host city</th></tr></thead><tbody></tbody></table></div>
  </details>
  <div id="com-tip" class="tip" hidden></div>
</div>
<noscript><p>The interactive map needs JavaScript; the figures above show all accepted abstracts. Every variant is in
<a href="{{ repo_url }}/blob/main/outputs/trends_center.csv">trends_center.csv</a>.</p></noscript>
<script type="application/json" id="com-data">{{ center_json }}</script>
{% endif %}

{{ m.toolbar(years, pooled) }}
{% set p = pooled %}

<h2 id="regions">World regions</h2>
<p>The country of the first author's affiliations, grouped into UN regions (the Americas split into Northern America
and Latin America and the Caribbean). An abstract counts once per region.</p>
{% if p %}
<section data-show-year="all">
<p>All years, {{ p.label }}.
{% for y in years if y.summary.first_country_coverage < 0.95 %}In {{ y.year }} only
{{ "{:.0%}".format(y.summary.first_country_coverage) }} of abstracts could be placed, and the misses lean non-US.
{% endfor %}</p>
{{ m.first_author_figure("all", "regions", "each world region", p.label) }}
{% if "trends_regions" in trends %}
{{ m.figure("img/trends_regions.png", "Talk rate per year for each world region, with 95% intervals.", "Year by year, first author.") }}
{% endif %}
{{ m.first_author_table(p.regions) }}
</section>
{% endif %}
{% for y in years %}
<section data-show-year="{{ y.year }}">
{% if y.summary.first_country_coverage < 0.95 %}
<p class="caveat"><strong>Only {{ "{:.0%}".format(y.summary.first_country_coverage) }} of {{ y.year }} abstracts could be
placed.</strong> That year's affiliations rarely give a city or country, so countries come from the resolved institution,
place names, or a hand-checked list of the remaining affiliations. Tested on earlier years, this fallback misses non-US abstracts more often, and the abstracts it misses
have a lower talk rate, so read {{ y.year }} regions with care.</p>
{% else %}
<p>ASHG {{ y.year }}: countries read from the affiliation's location for {{ "{:.1%}".format(y.summary.first_country_coverage) }} of abstracts.</p>
{% endif %}
{{ m.first_author_figure(y.year, "regions", "each world region") }}
{{ m.first_author_table(y.regions) }}
</section>
{% endfor %}

<h2 id="countries">Countries</h2>
<p>The 25 countries with the most abstracts; any without a talk are not listed.</p>
{% if p %}
<section data-show-year="all">
{{ m.first_author_table(p.countries) }}
</section>
{% endif %}
{% for y in years %}
<section data-show-year="{{ y.year }}">
{{ m.first_author_table(y.countries) }}
</section>
{% endfor %}

<h2 id="metros">Metro areas</h2>
<p>Institutions grouped by metro area: an abstract counts once per metro, however many of its institutions are there.
Institutions with sites in several metros (e.g. Mayo Clinic, Penn State) are left out, as are metros without a talk.
The figure shows the 20 metro areas with the most accepted abstracts. Local groups tend to bring
extra posters to a home meeting.</p>
{% if p %}
<section data-show-year="all">
<p>All years, {{ p.label }}: {{ "{:.0%}".format(p.summary.first_metro_coverage) }} of abstracts have a first-author metro.</p>
{{ m.first_author_figure("all", "metros", "the 20 metro areas with the most accepted abstracts", p.label) }}
{% if "trends_metros" in trends %}
{{ m.figure("img/trends_metros.png", "Abstracts and talk rate per year for the largest metro areas, with each year's host city marked.", "Year by year, first author.") }}
{% endif %}
{{ m.first_author_table(p.metros) }}
</section>
{% endif %}
{% for y in years %}
<section data-show-year="{{ y.year }}">
<p>ASHG {{ y.year }}{% if y.host %} was held in {{ y.host }}{% endif %}; {{ "{:.0%}".format(y.summary.first_metro_coverage) }}
of abstracts have a first-author metro.</p>
{{ m.first_author_figure(y.year, "metros", "the 20 metro areas with the most accepted abstracts") }}
{{ m.first_author_table(y.metros) }}
</section>
{% endfor %}
{% endblock %}
