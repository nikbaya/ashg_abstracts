<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% if page.file != "index.html" %}{{ page.title }} · {% endif %}ASHG abstracts</title>
<meta name="description" content="Which phrases, institutions and places are over-represented among talks (vs posters) at the ASHG annual meeting, {{ years[0].year }}–{{ years[-1].year }}.">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.title }} · ASHG abstracts">
<meta property="og:description" content="Who and what gets a talk at ASHG, from the published abstracts.">
<meta property="og:image" content="{{ site_url }}img/{{ years[-1].year }}_headline.png">
<meta property="og:url" content="{{ site_url }}{{ '' if page.file == 'index.html' else page.file }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='5' cy='8' r='4' fill='%232a78d6'/%3E%3Ccircle cx='11' cy='8' r='4' fill='%23e34948' fill-opacity='.85'/%3E%3C/svg%3E">
<link rel="stylesheet" href="assets/site.css?v={{ asset_v }}">
</head>
<body>
<header class="site-header"><div class="wrap">
  <a class="brand" href="index.html">ASHG abstracts <span>who and what gets a talk</span></a>
  <nav class="site-nav" aria-label="Sections">
  {% for p in pages %}
    <a href="{{ p.file }}"{% if p.file == page.file %} aria-current="page"{% endif %}>{{ p.label }}</a>
  {% endfor %}
  </nav>
</div></header>
<main class="wrap">
{% block content %}{% endblock %}
<nav class="pager" aria-label="Previous and next page">
  {% if prev %}<a class="prev" href="{{ prev.file }}"><span>← Previous</span>{{ prev.label }}</a>{% endif %}
  {% if next %}<a class="next" href="{{ next.file }}"><span>Next →</span>{{ next.label }}</a>{% endif %}
</nav>
</main>
<footer><div class="wrap">
  <p>Parsed from the ASHG annual meeting abstracts ({{ years[0].year }}–{{ years[-1].year }}). Abstracts © ASHG; only aggregate results are published here.</p>
  <p>Code and full aggregate tables: <a href="{{ repo_url }}">{{ repo_url | replace("https://", "") }}</a> · <a href="methods.html">Methods and caveats</a></p>
</div></footer>
<script src="assets/site.js?v={{ asset_v }}"></script>
</body>
</html>
