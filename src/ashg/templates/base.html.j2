<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% if page.file == "index.html" %}{{ page.title }}, {{ years[0].year }}–{{ years[-1].year }}{% else %}{{ page.title }} · ASHG abstracts{% endif %}</title>
<meta name="description" content="What the abstracts at the ASHG annual meeting say, {{ years[0].year }}–{{ years[-1].year }}: topics and wording over time, and which phrases, institutions and places are over-represented among talks (vs posters).">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.title }} · ASHG abstracts">
<meta property="og:description" content="Topics, wording and who presents at ASHG, from the published abstracts: what is rising, what is fading, and what leans toward talks over posters.">
<meta property="og:image" content="{{ site_url }}img/{{ years[-1].year }}_headline.png">
<meta property="og:url" content="{{ site_url }}{{ '' if page.file == 'index.html' else page.file }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='5' cy='8' r='4' fill='%232a78d6'/%3E%3Ccircle cx='11' cy='8' r='4' fill='%23e34948' fill-opacity='.85'/%3E%3C/svg%3E">
<link rel="stylesheet" href="assets/site.css?v={{ asset_v }}">
</head>
<body>
{% set icons = {
  "index.html": '<rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="9" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="2.5" y="9" width="4.5" height="4.5" rx="1"/><rect x="9" y="9" width="4.5" height="4.5" rx="1"/>',
  "phrases.html": '<path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"/><path d="M5.5 6.5h5"/>',
  "institutions.html": '<path d="M2 13.5h12M3.5 13.5v-7M6.5 13.5v-7M9.5 13.5v-7M12.5 13.5v-7M1.5 6.5 8 2.5l6.5 4z"/>',
  "geography.html": '<circle cx="8" cy="8" r="5.75"/><path d="M2.25 8h11.5M8 2.25c-2 1.9-2 9.6 0 11.5M8 2.25c2 1.9 2 9.6 0 11.5"/>',
  "authors.html": '<circle cx="8" cy="5.5" r="2.75"/><path d="M2.75 13.5c.5-2.75 2.6-4 5.25-4s4.75 1.25 5.25 4"/>',
  "similar.html": '<circle cx="8" cy="8" r="2"/><circle cx="3" cy="4" r="1.5"/><circle cx="13" cy="5" r="1.5"/><circle cx="11.5" cy="13" r="1.5"/><path d="M6.4 7 4.2 5M10 7.6l1.8-1.6M9 9.8l2 2"/>',
  "methods.html": '<path d="M6 2.5h4M6.75 2.5v4L3 12.5c-.5.9.1 1.5 1 1.5h8c.9 0 1.5-.6 1-1.5L9.25 6.5v-4M4.75 10h6.5"/>'
} %}
<header class="site-header"><div class="wrap">
  <a class="brand" href="index.html">ASHG abstracts</a>
  <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14"/></svg></button>
  <nav class="site-nav" id="site-nav" aria-label="Sections">
  {% for p in pages %}
    <div class="nav-item{% if p.sections %} has-menu{% endif %}">
    <a href="{{ p.file }}"{% if p.file == page.file %} aria-current="page"{% endif %}>{% if icons[p.file] %}<svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true">{{ icons[p.file] }}</svg>{% endif %}{{ p.label }}{% if p.sections %}<span class="caret" aria-hidden="true"></span>{% endif %}</a>
    {% if p.sections %}
    <div class="nav-menu">{% for a, l in p.sections %}<a href="{{ p.file }}#{{ a }}">{{ l }}</a>{% endfor %}</div>
    {% endif %}
    </div>
  {% endfor %}
  </nav>
</div></header>
<main class="wrap">
{% block content %}{% endblock %}
<nav class="pager" aria-label="Previous and next page">
  {% if prev %}<a class="prev" href="{{ prev.file }}"><span>← Previous</span>{{ prev.label }}</a>{% endif %}
  {% if next %}<a class="next" href="{{ next.file }}"><span>Next →</span>{{ next.label }}</a>{% endif %}
</nav>
</main>
<footer><div class="wrap">
  <p>Parsed from the ASHG annual meeting abstracts ({{ years[0].year }}–{{ years[-1].year }}). Abstracts © their authors; the collection © ASHG. No abstract text is reproduced here, only counts and rates.</p>
  <p>Code and full aggregate tables: <a href="{{ repo_url }}">{{ repo_url | replace("https://", "") }}</a> · <a href="methods.html">Methods and caveats</a></p>
</div></footer>
<script src="assets/site.js?v={{ asset_v }}"></script>
<script data-goatcounter="https://ashg-abstracts.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
