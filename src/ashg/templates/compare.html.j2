{% extends "base.html.j2" %}
{% block content %}
<h1>{{ page.title }}</h1>
<p class="lede sim-help">Pick two ASHG {{ years[-1].year }} abstracts by their first author and see how alike they are: text match, rank among each other's closest abstracts, and shared authors.</p>
<p class="sim-help">The text match is the same score as on <a href="similar.html">Find talks</a>: 100 is the 95th percentile of abstracts' closest pairs, and anything weaker than 10 shows as under 10%. Titles and abstract text are not shown (see <a href="methods.html#similar">how the match is made</a>).</p>
<div id="compare" data-src="{{ network_src }}" data-pairs="{{ pairs_src or '' }}" data-terms="{{ terms_src or '' }}">
  <div class="cmp-pick">
    <div class="cmp-slot" data-slot="a"><span class="lbl">First abstract</span><span class="sim-search"><input type="search" placeholder="First author or poster number, e.g. Smith" autocomplete="off" aria-label="First author of the first abstract"><div class="sim-results" hidden></div></span><div class="cmp-chosen"></div></div>
    <div class="cmp-slot" data-slot="b"><span class="lbl">Second abstract</span><span class="sim-search"><input type="search" placeholder="First author or poster number, e.g. 6041" autocomplete="off" aria-label="First author of the second abstract"><div class="sim-results" hidden></div></span><div class="cmp-chosen"></div></div>
  </div>
  <div id="cmp-out" class="cmp-out">Loading…</div>
</div>
<script src="assets/compare.js?v={{ asset_v }}"></script>
{% endblock %}
