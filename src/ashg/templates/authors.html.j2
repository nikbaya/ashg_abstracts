{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block content %}
<h1>{{ page.title }}</h1>
<p class="lede">Senior (last) authors whose abstracts most consistently became talks.</p>
<p>Ranked by the lower end of the 95% Wilson interval, so a 5-of-6 record outranks 2-of-2. Within a year the same
person is the same first + last name (plus a shared institution for common surnames).</p>
{{ m.toolbar(years, pooled) }}
{% if pooled %}
{% set p = pooled %}
<section data-show-year="all">
<h2>All years <span class="sub">· {{ p.label }}</span></h2>
<p>Senior authors with at least {{ p.min_abstracts }} abstracts over all years. The 2022–2024 booklets give only
initials, so across years the same person is the same first initial + last name; for common surnames they must also
share an institution, and two different spelled-out first names (2025–2026) are kept apart.</p>
{{ m.figure("img/all_senior_authors.png", "Talk rate with 95%% intervals for the top senior authors at ASHG %s." % p.label) }}
<div class="scroll">{{ p.senior_authors }}</div>
</section>
{% endif %}
{% for y in years %}
<section data-show-year="{{ y.year }}">
{{ m.year_heading(y) }}
<p>Senior authors with at least {{ y.min_abstracts }} abstracts that year{% if y.year <= 2024 %}; the {{ y.year }}
booklet gives only initials{% endif %}.</p>
{{ m.figure("img/%d_senior_authors.png" % y.year, "Talk rate with 95%% intervals for the top senior authors at ASHG %d." % y.year) }}
<div class="scroll">{{ y.senior_authors }}</div>
</section>
{% endfor %}
{% endblock %}
