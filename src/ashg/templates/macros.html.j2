{% macro toolbar(years, pooled=None) %}
<div class="toolbar">
  <span class="lbl">Year</span>
  <span class="seg" role="group" aria-label="Year" data-control="year" data-default="{{ 'all' if pooled else years[-1].year }}">
  {% if pooled %}<button type="button" data-value="all">All years</button>{% endif %}
  {% for y in years %}<button type="button" data-value="{{ y.year }}">{{ y.year }}</button>{% endfor %}
  </span>
</div>
{% endmacro %}

{% macro figure(src, alt, caption=None) %}
<figure class="fig">
  <a href="{{ src }}"><img src="{{ src }}" alt="{{ alt }}" loading="lazy"></a>
  {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
</figure>
{% endmacro %}

{% macro first_author_table(table) %}
<div class="scroll"><p class="table-title">By first author</p>{{ table }}</div>
{% endmacro %}

{% macro year_heading(y) %}
<h2>ASHG {{ y.year }}{% if y.host %} <span class="sub">· {{ y.host }}</span>{% endif %}</h2>
{% endmacro %}

{% macro first_author_figure(year, name, what, label=None) %}
{{ figure("img/%s_%s.png" % (year, name), "Talk rate with 95%% intervals for %s by first author, ASHG %s." % (what, label or year)) }}
{% endmacro %}

{% macro details(summary) %}
<details class="table"><summary>{{ summary }}</summary>
{{ caller() }}
</details>
{% endmacro %}
