{% macro year_scope(years, pooled=None) %}
{# the year toggle sticks only while its sections are on screen, then scrolls away with them #}
<div class="year-scope">
<div class="toolbar">
  <span class="lbl">Year</span>
  <span class="seg" role="group" aria-label="Year" data-control="year" data-default="{{ 'all' if pooled else years[-1].year }}">
  {% if pooled %}<button type="button" data-value="all">All years</button>{% endif %}
  {% for y in years %}<button type="button" data-value="{{ y.year }}">{{ y.year }}</button>{% endfor %}
  </span>
</div>
{{ caller() }}
</div>
{% endmacro %}

{% macro figure(src, alt, caption=None) %}
<figure class="fig">
  <a href="{{ src }}"><img src="{{ src }}" alt="{{ alt }}" loading="lazy"></a>
  {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
</figure>
{% endmacro %}

{% macro first_author_table(table) %}
<div class="scroll"><p class="table-title">By first author</p>{{ table }}</div>
{% endmacro %}

{% macro year_heading(y) %}
<h2>ASHG {{ y.year }}{% if y.host %} <span class="sub">· {{ y.host }}</span>{% endif %}</h2>
{% endmacro %}

{% macro first_author_figure(year, name, what, label=None) %}
{{ figure("img/%s_%s.png" % (year, name), "Talk rate with 95%% intervals for %s by first author, ASHG %s." % (what, label or year)) }}
{% endmacro %}

{% macro details(summary) %}
<details class="table"><summary>{{ summary }}</summary>
{{ caller() }}
</details>
{% endmacro %}

{% macro explorer(drivers_json, src=None, num=None, heading="Look up a phrase") %}
<section class="explorer{% if num %} in-vignette{% endif %}">
<h2 id="explorer">{% if num %}<span class="num">{{ num }}</span>{% endif %}{{ heading }}</h2>
{{ caller() }}
<div class="filters">
  <label>Find <span class="sg-wrap"><input type="search" id="drv-search" placeholder="e.g. enhancer" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="drv-suggest" aria-autocomplete="list"><ul id="drv-suggest" role="listbox" hidden></ul></span></label>
  <label>Phrase <select id="drv-phrase"></select></label>
  <span class="lbl">Plot</span><span class="seg" id="drv-mode" role="group" aria-label="Plot">
    <button type="button" data-mode="abs" aria-pressed="true">Shares</button><button type="button" data-mode="rel" aria-pressed="false">Odds of a talk</button>
  </span>
</div>
<div class="drv-trend">
  <svg id="drv-chart" role="img" viewBox="0 0 360 150"></svg>
  <div><p id="drv-or"></p>
  <div class="legend" id="drv-legend"><span><i style="background: var(--talk)"></i>share of talks</span><span><i style="background: var(--poster)"></i>share of posters</span></div>
  <p class="legend" id="drv-ratio-note" hidden>Odds of a talk with vs without it each year, with 95% CIs; above 1× it is more common in talks.</p></div>
</div>
<p id="drv-none" class="empty" hidden>No institution or metro breakdown for this phrase: that is kept for the phrases listed before you search.</p>
<div id="drv-who">
<div class="filters"><span class="lbl">Who writes about it</span><span class="seg" id="drv-year" role="group" aria-label="Year"></span>
  <span class="lbl">Bars</span><span class="seg" id="drv-bar-mode" role="group" aria-label="Bars">
    <button type="button" data-mode="abs" aria-pressed="true">Counts</button><button type="button" data-mode="rel" aria-pressed="false">Odds of a talk</button>
  </span>
</div>
<p id="drv-summary"></p>
<div class="legend" id="drv-bar-legend"><span><i style="background: var(--talk)"></i>talks</span><span><i style="background: var(--poster)"></i>posters</span></div>
<p class="legend" id="drv-bar-note" hidden>Odds of a talk for that institution's (or metro's) abstracts with vs without it, as for the phrase overall above: dot and 95% CI, log scale; the dashed line is 1×, no difference. Few abstracts make for wide intervals.</p>
<div class="cols bars">
  <div><h4>Institutions</h4><div id="drv-institutes"></div></div>
  <div><h4>Metro areas</h4><div id="drv-metros"></div></div>
</div>
</div>
<div class="tip" id="drv-tip" role="tooltip" hidden></div>
{% if src %}<script type="application/json" id="drv-data" data-src="{{ src }}"></script>
{% else %}<script type="application/json" id="drv-data">{{ drivers_json }}</script>{% endif %}
</section>
{% endmacro %}

{% macro center_map(center_json, host='with') %}
<div id="com" class="com" data-host="{{ host }}" hidden>
  <div class="filters">
    <span class="lbl">Map</span>
    <span class="seg" role="group" aria-label="Map" data-com="map"><button type="button" data-value="na">North America</button><button type="button" data-value="world">Worldwide</button></span>
    <span class="lbl">Show</span>
    <span class="seg" role="group" aria-label="Show" data-com="group"><button type="button" data-value="abstracts">All abstracts</button><button type="button" data-value="talks">Talks</button></span>
  </div>
  <div class="filters">
    <span class="lbl">Host-city first authors</span>
    <span class="seg" role="group" aria-label="Host-city first authors" data-com="host"><button type="button" data-value="with">Included</button><button type="button" data-value="without">Removed</button></span>
    <span id="com-na-ctl"><span class="lbl">North American first authors</span>
    <span class="seg" role="group" aria-label="North American first authors" data-com="na"><button type="button" data-value="with">Included</button><button type="button" data-value="without">Removed</button></span></span>
  </div>
  <svg id="com-map" class="com-map" role="img"></svg>
  <div class="legend"><span><i class="com-key dot"></i><span id="com-dot-key">center of mass, each year</span></span>
    <span id="com-ghost-key"><i class="com-key ghost"></i>with host-city first authors</span></div>
  <p id="com-note"></p>
  <details class="table"><summary>Table</summary>
  <div class="scroll"><table id="com-table"><thead><tr><th class="text">Year</th><th class="text">Host city</th>
  <th class="text">Center</th><th id="com-n-head">Abstracts</th><th>From host city</th><th>Moved by host city</th></tr></thead><tbody></tbody></table></div>
  </details>
  <div id="com-tip" class="tip" hidden></div>
</div>
<script type="application/json" id="com-data">{{ center_json }}</script>
{% endmacro %}

{% macro words_table(years, words_enriched_json, src=None, show=50) %}
<div class="filters">
  <label>Find a word <input type="search" id="we-search" placeholder="e.g. framework" autocomplete="off"></label>
  <span class="lbl" id="we-count" aria-live="polite"></span>
</div>
<div class="scroll"><table id="we-table">
<thead><tr><th class="text" data-k="0">Word</th><th data-k="1">{{ years[-1].year }} abstracts</th>
<th data-k="2">{{ years[0].year }}–{{ years[-2].year }} abstracts</th><th data-k="3">Odds ratio</th>
<th data-k="4" aria-sort="ascending">p</th></tr></thead>
<tbody id="we-body"></tbody></table></div>
<p class="table-note">Every word in the figure, the most overrepresented first; click a heading to sort. Bold p:
significant after Bonferroni correction. A word less common in {{ years[-1].year }} has an odds ratio below 1 and p near 1.</p>
{% if src %}<script type="application/json" id="we-data" data-src="{{ src }}" data-show="{{ show }}"></script>
{% else %}<script type="application/json" id="we-data" data-show="{{ show }}">{{ words_enriched_json }}</script>{% endif %}
{% endmacro %}
