{% extends "base.html.j2" %}
{% block content %}
<h1>{{ page.title }}</h1>
<p class="lede sim-help">Pick an abstract, symposium talk or session and see which others at ASHG {{ years[-1].year }} read most like it, or share its authors.</p>
<p class="sim-help">Search by author (first authors, or co-authors to find their abstracts), or take a random one; hover (or tap) a bubble for its details and click (or tap twice) to
move on to it. Bubbles are colored by track and sized by how close the match is. Degrees widen the view to neighbors of neighbors (up to 3; past that it would reach nearly every abstract). Titles and abstract text are not
shown here (see <a href="methods.html#similar">how the match is made</a>).</p>
<div id="similar" data-src="{{ network_src }}">
<div class="toolbar">
  <span class="lbl">Match by</span>
  <span class="seg" role="group" aria-label="Match by" data-sim="by">
    <button type="button" data-value="nt" aria-pressed="true">Text</button>
    <button type="button" data-value="na" aria-pressed="false">Co-authors</button>
  </span>
  <span class="lbl">Degrees</span>
  <span class="seg" role="group" aria-label="Degrees of separation" data-sim="degrees">
    <button type="button" data-value="1" aria-pressed="true">1</button>
    <button type="button" data-value="2" aria-pressed="false">2</button>
    <button type="button" data-value="3" aria-pressed="false">3</button>
  </span>
  <label><input type="checkbox" id="sim-past"> Hide past sessions</label>
  <span class="sim-search">
    <input id="sim-q" type="search" placeholder="Author, e.g. Smith" autocomplete="off" aria-label="Search by author">
    <button type="button" id="sim-random">Random</button>
    <div id="sim-results" class="sim-results" hidden></div>
  </span>
</div>
<div id="sim-trail" class="sim-trail" hidden><span class="lbl">Path</span><span id="sim-trail-list"></span><button type="button" id="sim-clear">Clear history</button></div>
<div class="sim-main">
<div id="sim-stage" class="sim-stage">
  <svg id="sim-graph" role="img" aria-label="Abstracts most similar to the selected one"></svg>
  <div id="sim-tip" class="sim-tip" hidden></div>
</div>
<aside class="sim-side" aria-label="Most similar abstracts"><div class="sim-head"><h2>Related</h2><div class="seg sim-sort" role="group" aria-label="Sort by" data-sim="sort"><button type="button" data-value="match" aria-pressed="true">Most similar</button><button type="button" data-value="time" aria-pressed="false">Upcoming</button></div></div><ol id="sim-list"></ol></aside>
</div>
<div id="sim-card" class="sim-card">Loading…</div>
<details class="table"><summary>Track colors</summary><ul id="sim-legend" class="sim-legend"></ul></details>
</div>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="assets/similar.js?v={{ asset_v }}"></script>
{% endblock %}
