{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block content %}
<h1>{{ page.title }}</h1>
<p class="lede">Talk rate at the institutions with the most abstracts.</p>
<p>Credit goes to every institution of the first author.
An abstract can count for several institutions, so rows don't sum to the total. Institutions are resolved with a
hand-curated list of {{ n_institutes }} institutions, which places about {{ "{:.0%}".format(years[-1].summary.first_inst_coverage) }} of
abstracts. The figure shows the 20 highest talk rates among the 50 institutions with the most abstracts;
the tables list all 50, except any without a talk.</p>
{{ m.toolbar(years, pooled) }}
{% if pooled %}
{% set p = pooled %}
<section data-show-year="all">
<h2>All years <span class="sub">· {{ p.label }}</span></h2>
<p>Pooled counts over every meeting, compared with the pooled talk rate of
{{ "%.1f"|format(100 * p.summary.talk_rate) }}%.</p>
{{ m.first_author_figure("all", "institutions", "the 20 institutions with the highest talk rate among the 50 largest", p.label) }}
{{ m.first_author_table(p.institutions) }}
</section>
{% endif %}
{% for y in years %}
<section data-show-year="{{ y.year }}">
{{ m.year_heading(y) }}
{{ m.first_author_figure(y.year, "institutions", "the 20 institutions with the highest talk rate among the 50 largest") }}
{{ m.first_author_table(y.institutions) }}
</section>
{% endfor %}
{% endblock %}
